@model Assignment1.Models.Attendee

@{
    ViewData["Title"] = "Edit Attendee";
}

<h1>Edit Attendee</h1>

<form asp-action="EditAttendee"
      asp-route-eventId="@Model.EventId"
      asp-route-attendeeId="@Model.Id"
      method="post">

    <input type="hidden" asp-for="Id" />

    <label asp-for="Name"></label>
    <input asp-for="Name" />

    <label asp-for="Email"></label>
    <input asp-for="Email" />

    <button type="submit">Save Changes</button>
    <a href="/events/@Model.EventId/attendees">Cancel</a>
</form>