@model Assignment1.Models.Event


@{
    ViewData["Title"] = "Event Details";
}

<h1>@Model.Title</h1>

@if (!string.IsNullOrEmpty(Model.BannerUrl))
{
    <img src="@Model.BannerUrl" alt="Event banner" style="max-width: 600px;" />
}

<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Date:</strong> @Model.Date</p>
<p><strong>Location:</strong> @Model.Location</p>

@if (User.IsInRole("Organizer"))
{
    <div class="mt-4 mb-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">Edit Event</a>

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post"
              style="display:inline;">
            <button type="submit"
                    class="btn btn-danger"
                    style="background-color: red !important; color: white !important;">
                Delete Event
            </button>
        </form>

        <a href="/events/@Model.Id/attendees"
           class="btn btn-success">Manage Attendees</a>
    </div>

}

@if (User.Identity!.IsAuthenticated)
{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isRegistered = Model.Attendees.Any(a => a.UserId == userId);

    if (isRegistered)
    {
        <p class="text-success">You are registered for this event!</p>

        <form asp-controller="EventManager"
              asp-action="Unregister"
              asp-route-eventId="@Model.Id"
              method="post">
            <button type="submit" class="btn btn-danger">Unregister</button>
        </form>
    }
    else
    {
        <form asp-controller="EventManager"
              asp-action="Register"
              asp-route-eventId="@Model.Id"
              method="post">
            <button type="submit" class="btn btn-success">Register for Event</button>
        </form>
    }

    <h2>Attendees (<span id="attendee-count">@Model.Attendees.Count</span>)</h2>

    <ul class="attendee-list" id="attendee-list">
        @foreach (var attendee in Model.Attendees)
        {
            <li>@attendee.Name (@attendee.Email)</li>
        }
    </ul>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    
<script>

    const eventId = @Model.Id;

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/attendeeHub")
        .build();

    connection.start()
        .then(() => connection.invoke("JoinEventGroup", eventId))
        .catch(err => console.error(err));
    
    // handler for attendees being registered
    connection.on("AttendeeRegistered", function (data) {
        document.getElementById("attendee-count").textContent = data.attendeeCount;

        const attendeeList = document.getElementById("attendee-list");
        const newAttendee = document.createElement("li");

        newAttendee.textContent = data.attendeeName;
        attendeeList.appendChild(newAttendee);
    });

    // handler for attendees being unregistered
    connection.on("AttendeeUnregistered", function (data) {
        document.getElementById("attendee-count").textContent =
            data.attendeeCount;

        const attendeeList = document.getElementById("attendee-list");
        const attendees = attendeeList.getElementsByTagName("li");

        // need to remove just the one attendee without refreshing the entire list
        for (let attendee of attendees) {
            if (attendee.textContent.startsWith(data.attendeeName + " (")) {
                attendee.remove();
                break;
            }
        }
    });

    // handler for organizer notification on attendee registration
    connection.on("OrganizerNotification", function (message) {
        alert(message);
    });

</script>

<a asp-action="Index">Back to Events</a>