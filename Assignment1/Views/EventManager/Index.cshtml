@model List<Assignment1.Models.Event>

@{
    ViewData["Title"] = "Home Page";
}

<h1>Event Manager</h1>
<h6>Select an event to manage attendees</h6>

@if (User.IsInRole("Organizer"))
{
    <a asp-action="Create" class="btn btn-primary">Create Event</a>
}

<table>
    <tr>
        <th>Title</th>
        <th>Date</th>
        <th>Location</th>
        <th>Manage</th>
    </tr>

    @foreach (var eventItem in Model)
    {
        <tr>
            <td>@eventItem.Title</td>
            <td>@eventItem.Date</td>
            <td>@eventItem.Location</td>
            <td>
                @if (User.IsInRole("Organizer"))
                {
                    <a href="/events/@eventItem.Id/attendees"
                       class="btn btn-success">Manage Attendees</a>

                    <a asp-action="Edit"
                       asp-route-id="@eventItem.Id"
                       class="btn btn-primary">Edit</a>

                    <form asp-action="Delete"
                          asp-route-id="@eventItem.Id"
                          method="post"
                          style="display:inline;">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                }

                <a asp-action="EventDetails"
                   asp-route-id="@eventItem.Id"
                   class="btn btn-outline-secondary">Details</a>
            </td>
        </tr>
    }

</table>