@model List<Assignment1.Models.Event>

@{
    ViewData["Title"] = "Home Page";
}

<h1>Event Manager</h1>
<h6>Select an event to manage attendees</h6>

<a asp-action="Create">Create Event</a>

<table>
    <tr>
        <th>Title</th>
        <th>Date</th>
        <th>Location</th>
        <th>Manage</th>
    </tr>


@foreach (var eventItem in Model)
{
    <tr>
        <td>@eventItem.Title</td>
        <td>@eventItem.Date</td>
        <td>@eventItem.Location</td>
        <td>
            <!-- manage attendees btn -->
            <a href="/events/@eventItem.Id/attendees">Manage Attendees</a>

            <!-- edit and delete buttons -->
            <a asp-action="Edit" asp-route-id="@eventItem.Id">Edit</a>
            <form asp-action="Delete" asp-route-id="@eventItem.Id" method="post" style="display:inline;">
                <button type="submit">Delete</button>
            </form>
                <!-- event details btn -->
                <a asp-action="EventDetails" asp-route-id="@eventItem.Id">Details</a>
        </td>
    </tr>
}

</table>